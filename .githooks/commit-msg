#!/bin/sh
# Enforces the "semantic" rule from COMMITS.md (Conventional Commits).
msg_file="$1"
subject=$(sed -n '1p' "$msg_file")

# Let git's own messages and autosquash markers through.
case "$subject" in
  Merge\ *|fixup!\ *|squash!\ *|amend!\ *) exit 0 ;;
esac

types='feat|fix|perf|refactor|style|test|docs|build|ci|chore|revert'
pattern="^($types)(\([a-z0-9][a-z0-9/-]*\))?!?: [a-z0-9\`].*[^.]$"

fail() {
  echo "✗ commit message: $1" >&2
  echo "  got:      $subject" >&2
  echo "  expected: <type>(<scope>): <imperative, lowercase subject, no period>" >&2
  echo "  types:    $types   (see COMMITS.md)" >&2
  exit 1
}

echo "$subject" | grep -Eq "$pattern" || fail "subject doesn't follow Conventional Commits"
[ "${#subject}" -le 72 ] || fail "subject is ${#subject} chars; keep it to 72"
echo "$subject" | grep -Eq ': (added|adds|adding|fixed|fixes|fixing|updated|updates|updating|removed|removes|changed|changes) ' \
  && fail "use the imperative mood (add, fix, update), not past tense or third person"

second=$(sed -n '2p' "$msg_file")
[ -z "$second" ] || case "$second" in \#*) ;; *) fail "leave a blank line between subject and body" ;; esac
exit 0
