{
  "name": "focus-bobby",
  "version": "0.1.0-rc3",
  "description": "Bobby: a PR reviewer that shows one focused page at a time, in dependency order",
  "keywords": [
    "code-review",
    "pull-request",
    "github",
    "cli",
    "diff"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/angrybayblade/bobby.git"
  },
  "type": "module",
  "bin": {
    "bobby": "./src/cli.ts"
  },
  "files": [
    "src",
    "public",
    "schema",
    "SPEC.md",
    "README.md"
  ],
  "engines": {
    "bun": ">=1.1"
  },
  "scripts": {
    "review": "bun run src/cli.ts",
    "check": "sh scripts/check.sh",
    "typecheck": "bunx tsc --noEmit",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "build": "bun scripts/build.ts",
    "prepublishOnly": "bun run check"
  },
  "devDependencies": {
    "@types/bun": "1.1.14",
    "typescript": "5.6.3"
  },
  "dependencies": {
    "tree-sitter-wasms": "0.1.13",
    "web-tree-sitter": "0.20.8"
  }
}
